# SentinelChain Environment Variables
# Copy this file to .env and fill in your API keys

# Application
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Allowed CORS origins - comma-separated list overrides backend/config.yaml
# CORS_ORIGINS=http://localhost:3000,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# Database (nested settings use a double underscore: DATABASE__URL)
DATABASE__URL=sqlite+aiosqlite:///./sentinelchain.db

# LLM Providers
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Search & Scraping Tools
TAVILY_API_KEY=your_tavily_key_here
EXA_API_KEY=your_exa_key_here
APIFY_API_TOKEN=your_apify_token_here
E2B_API_KEY=your_e2b_key_here

# Vector Database
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=sentinelchain-suppliers

# Cache & Session
REDIS_URL=redis://localhost:6379

# Observability
LANGSMITH_API_KEY=your_langsmith_key_here
WANDB_API_KEY=your_wandb_key_here
WANDB_ENTITY=your_wandb_entity

# Security
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
JWT_SECRET_KEY=change-me-in-production

# MCP Servers (optional)
MCP_CRM_COMMAND=python
MCP_CRM_ARGS=["-m", "mcp_servers.crm"]
MCP_ERP_COMMAND=python
MCP_ERP_ARGS=["-m", "mcp_servers.erp"]